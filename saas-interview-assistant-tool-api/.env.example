PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/siat
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d
OPENAI_API_KEY=sk-...
DEEPGRAM_API_KEY=...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_KEY=re_...
EMAIL_FROM=KrackAI <hello@krackai.org>
EMAILJS_PUBLIC_KEY=...
EMAILJS_PRIVATE_KEY=...
EMAILJS_SERVICE_ID=...
EMAILJS_TEMPLATE_ID=...
FRONTEND_URL=https://krackai.org
NODE_ENV=production

# ── In-development: Voice cloning (practice/rehearsal only) — HIDDEN by default ──
# Leave ENABLE_VOICE_CLONE unset/false in production. The /dev/voice/* routes 404
# until it's "true". Set both only on a dev server to work on the feature.
ENABLE_VOICE_CLONE=false
ELEVENLABS_API_KEY=
